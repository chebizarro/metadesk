# Maintainer: Chris Daley <chebizarro@gmail.com>
# Release template: owner MUST replace the two checksums from signed Arch-native
# artifacts. Never use an Ubuntu binary tree or SKIP to evade ABI/integrity gates.
pkgname=metadesk-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='Nostr-native desktop host and video client (prebuilt)'
arch=('x86_64' 'aarch64')
url='https://github.com/chebizarro/metadesk'
license=('MIT' 'Apache-2.0')
provides=('metadesk')
conflicts=('metadesk')
depends=('bzip2' 'ffmpeg' 'sdl2' 'pipewire' 'at-spi2-core' 'glib2' 'libsecret' 'systemd-libs'
         'dbus' 'libxcb>=1.15' 'libxau' 'util-linux-libs' 'curl' 'libwebsockets' 'openssl' 'libsecp256k1'
         'jansson' 'cjson' 'libb2' 'libyuv')
# Match the signed archive selected for this release. Never ship a Manager
# ELF without its runtime dependency list (or add GUI deps to a CLI tree).
_with_manager=false
if [[ $_with_manager == true ]]; then
    depends+=('gtk4>=4.14' 'libadwaita>=1.5' 'gdk-pixbuf2' 'qrencode' 'zbar')
fi
optdepends=('fipsd: FIPS mesh transport' 'xdg-desktop-portal: desktop capture portal'
            'xdg-desktop-portal-gtk: GTK portal backend'
            'xdg-desktop-portal-wlr: wlroots capture portal backend')
options=('!strip' '!debug')
source_x86_64=("${url}/releases/download/v${pkgver}/metadesk-${pkgver}-archlinux-x86_64.tar.gz")
source_aarch64=("${url}/releases/download/v${pkgver}/metadesk-${pkgver}-archlinux-aarch64.tar.gz")
sha256sums_x86_64=('OWNER_SHA256_X86_64')
sha256sums_aarch64=('OWNER_SHA256_AARCH64')

package() {
    local has_manager=false
    [[ ! -x "$srcdir/tree/usr/bin/metadesk-manager" ]] || has_manager=true
    [[ $has_manager == "$_with_manager" ]] || return 1
    install -d "$pkgdir/usr"
    cp -a "$srcdir/tree/usr/." "$pkgdir/usr/"
    install -Dm644 "$srcdir/tree/usr/share/doc/metadesk/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/tree/usr/share/doc/metadesk/nostrc-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/nostrc-LICENSE"
    install -Dm644 "$srcdir/tree/usr/share/doc/metadesk/imgui-LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/imgui-LICENSE.txt"
}

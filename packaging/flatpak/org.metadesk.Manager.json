{
  "app-id": "org.metadesk.Manager",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "metadesk-manager",
  "finish-args": [
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=ipc",
    "--device=dri",
    "--talk-name=org.freedesktop.secrets"
  ],
  "build-options": {
    "env": {
      "CMAKE_BUILD_PARALLEL_LEVEL": "2",
      "MAKEFLAGS": "-j2"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/lib/*.a",
    "/lib/cmake",
    "/lib/metadesk-nostrc",
    "/share/man",
    "/share/aclocal",
    "/lib/*.la",
    "/bin/patchelf",
    "/bin/yuvconvert",
    "/COPYING.LGPLv2.1"
  ],
  "modules": [
    "modules.json",
    {
      "name": "libqrencode",
      "buildsystem": "cmake-ninja",
      "config-opts": ["-DBUILD_SHARED_LIBS=ON", "-DWITH_TOOLS=OFF", "-DWITHOUT_PNG=ON"],
      "post-install": ["install -Dm644 COPYING /app/share/licenses/metadesk/libqrencode-COPYING"],
      "sources": [{
        "type": "archive",
        "url": "https://codeload.github.com/fukuchi/libqrencode/tar.gz/refs/tags/v4.1.1",
        "sha256": "5385bc1b8c2f20f3b91d258bf8ccc8cf62023935df2d2676b5b67049f31a049c"
      }]
    },
    {
      "name": "zbar",
      "buildsystem": "autotools",
      "config-opts": [
        "--enable-codes=qrcode", "--disable-video", "--disable-doc", "--disable-nls",
        "--without-gtk", "--without-qt", "--without-python", "--without-java",
        "--without-jpeg", "--without-imagemagick", "--without-x", "--without-dbus"
      ],
      "cleanup": ["/bin/*"],
      "post-install": ["install -Dm644 COPYING /app/share/licenses/metadesk/zbar-COPYING"],
      "sources": [{
        "type": "archive",
        "url": "https://codeload.github.com/mchehab/zbar/tar.gz/refs/tags/0.23.93",
        "sha256": "212dfab527894b8bcbcc7cd1d43d63f5604a07473d31a5f02889e372614ebe28"
      }]
    },
    {
      "name": "metadesk-manager",
      "buildsystem": "simple",
      "build-commands": [
        "sh packaging/flatpak/build-product.sh \"$PWD\" /app/lib/metadesk-nostrc \"$PWD/_build\" /app manager",
        "sh packaging/flatpak/wrap-runtime.sh manager",
        "install -Dm644 packaging/flatpak/assets/org.metadesk.Manager.desktop /app/share/applications/org.metadesk.Manager.desktop",
        "install -Dm644 packaging/flatpak/assets/org.metadesk.Manager.metainfo.xml /app/share/metainfo/org.metadesk.Manager.metainfo.xml",
        "install -Dm644 packaging/flatpak/assets/org.metadesk.Manager.svg /app/share/icons/hicolor/scalable/apps/org.metadesk.Manager.svg",
        "install -Dm644 packaging/appimage/tests/frame.h264 /app/share/metadesk/frame.h264"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            ".beads",
            "build",
            "artifacts",
            "packaging/appimage/output",
            "packaging/flatpak/output",
            ".flatpak-builder"
          ]
        }
      ],
      "build-options": {
        "cflags": "-I/app/include",
        "cxxflags": "-I/app/include",
        "ldflags": "-L/app/lib",
        "env": {
          "LIBRARY_PATH": "/app/lib"
        }
      }
    }
  ]
}

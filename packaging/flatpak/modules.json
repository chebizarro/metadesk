{
  "name": "dependencies",
  "buildsystem": "simple",
  "build-commands": [],
  "modules": [
    {
      "name": "cjson",
      "post-install": [
        "install -Dm644 \"$FLATPAK_BUILDER_BUILDDIR/LICENSE\" /app/share/licenses/cjson/LICENSE"
      ],
      "buildsystem": "cmake-ninja",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/DaveGamble/cJSON.git",
          "commit": "c859b25da02955fef659d658b8f324b5cde87be3",
          "disable-submodules": true,
          "tag": "v1.7.19"
        }
      ],
      "config-opts": [
        "-DENABLE_CJSON_TEST=OFF",
        "-DENABLE_CJSON_UTILS=OFF",
        "-DBUILD_SHARED_LIBS=ON",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ]
    },
    {
      "name": "libb2",
      "post-install": [
        "install -Dm644 \"$FLATPAK_BUILDER_BUILDDIR/COPYING\" /app/share/licenses/libb2/COPYING"
      ],
      "buildsystem": "autotools",
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/BLAKE2/libb2/releases/download/v0.98.1/libb2-0.98.1.tar.gz",
          "sha256": "53626fddce753c454a3fea581cbbc7fe9bbcf0bc70416d48fdbbf5d87ef6c72e",
          "archive-type": "tar-gzip"
        }
      ],
      "config-opts": [
        "--disable-static",
        "--disable-openmp"
      ]
    },
    {
      "name": "jansson",
      "post-install": [
        "install -Dm644 \"$FLATPAK_BUILDER_BUILDDIR/LICENSE\" /app/share/licenses/jansson/LICENSE"
      ],
      "buildsystem": "cmake-ninja",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/akheron/jansson.git",
          "commit": "684e18c927e89615c2d501737e90018f4930d6c5",
          "disable-submodules": true,
          "tag": "v2.14"
        }
      ],
      "config-opts": [
        "-DJANSSON_BUILD_SHARED_LIBS=ON",
        "-DJANSSON_BUILD_DOCS=OFF",
        "-DJANSSON_BUILD_TESTS=OFF",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ]
    },
    {
      "name": "secp256k1",
      "post-install": [
        "install -Dm644 \"$FLATPAK_BUILDER_BUILDDIR/COPYING\" /app/share/licenses/secp256k1/COPYING"
      ],
      "buildsystem": "cmake-ninja",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/bitcoin-core/secp256k1.git",
          "commit": "0cdc758a56360bf58a851fe91085a327ec97685a",
          "disable-submodules": true,
          "tag": "v0.6.0"
        }
      ],
      "config-opts": [
        "-DBUILD_SHARED_LIBS=ON",
        "-DSECP256K1_ENABLE_MODULE_RECOVERY=ON",
        "-DSECP256K1_BUILD_TESTS=OFF",
        "-DSECP256K1_BUILD_BENCHMARK=OFF",
        "-DSECP256K1_BUILD_EXHAUSTIVE_TESTS=OFF",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ]
    },
    {
      "name": "nsync",
      "post-install": [
        "install -Dm644 \"$FLATPAK_BUILDER_BUILDDIR/LICENSE\" /app/share/licenses/nsync/LICENSE"
      ],
      "buildsystem": "cmake-ninja",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/google/nsync.git",
          "commit": "5b420ef6b16532a4fad4be1fde8e483b6b7bd8f4",
          "disable-submodules": true,
          "tag": "1.30.0"
        }
      ],
      "config-opts": [
        "-DBUILD_SHARED_LIBS=ON",
        "-DNSYNC_ENABLE_TESTS=OFF",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ]
    },
    {
      "name": "libwebsockets",
      "post-install": [
        "install -Dm644 \"$FLATPAK_BUILDER_BUILDDIR/LICENSE\" /app/share/licenses/libwebsockets/LICENSE"
      ],
      "buildsystem": "cmake-ninja",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/warmcat/libwebsockets.git",
          "commit": "4415e84c095857629863804e941b9e1c2e9347ef",
          "disable-submodules": true,
          "tag": "v4.3.3"
        }
      ],
      "config-opts": [
        "-DLWS_WITH_STATIC=OFF",
        "-DLWS_WITH_SHARED=ON",
        "-DLWS_WITHOUT_TESTAPPS=ON",
        "-DLWS_WITH_LIBUV=OFF",
        "-DLWS_WITH_GLIB=OFF",
        "-DLWS_WITH_LIBEVENT=OFF",
        "-DLWS_WITH_EVLIB_PLUGINS=OFF",
        "-DLWS_WITHOUT_EXTENSIONS=ON",
        "-DLWS_WITHOUT_CLIENT=OFF",
        "-DLWS_WITHOUT_SERVER=OFF",
        "-DLWS_WITH_HTTP2=OFF",
        "-DLWS_WITH_EXTERNAL_POLL=ON",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ]
    },
    {
      "name": "libyuv",
      "post-install": [
        "install -Dm644 \"$FLATPAK_BUILDER_BUILDDIR/LICENSE\" /app/share/licenses/libyuv/LICENSE",
        "install -Dm644 \"$FLATPAK_BUILDER_BUILDDIR/PATENTS\" /app/share/licenses/libyuv/PATENTS",
        "install -Dm644 \"$FLATPAK_BUILDER_BUILDDIR/AUTHORS\" /app/share/licenses/libyuv/AUTHORS"
      ],
      "buildsystem": "cmake-ninja",
      "sources": [
        {
          "type": "git",
          "url": "https://chromium.googlesource.com/libyuv/libyuv",
          "commit": "0ec9f68d82634f6f3414aaaf780e03f9edf002b3",
          "disable-submodules": true
        }
      ],
      "config-opts": [
        "-DCMAKE_DISABLE_FIND_PACKAGE_JPEG=ON",
        "-DUNIT_TEST=OFF",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ]
    },
    {
      "name": "sdl2",
      "post-install": [
        "install -Dm644 \"$FLATPAK_BUILDER_BUILDDIR/LICENSE.txt\" /app/share/licenses/sdl2/LICENSE.txt"
      ],
      "buildsystem": "cmake-ninja",
      "sources": [
        {
          "type": "archive",
          "url": "https://www.libsdl.org/release/SDL2-2.32.10.tar.gz",
          "sha256": "5f5993c530f084535c65a6879e9b26ad441169b3e25d789d83287040a9ca5165",
          "archive-type": "tar-gzip"
        }
      ],
      "config-opts": [
        "-DSDL_SHARED=ON",
        "-DSDL_STATIC=OFF",
        "-DSDL_TEST=OFF",
        "-DSDL_TESTS=OFF",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ],
      "builddir": true
    },
    {
      "name": "nv-codec-headers",
      "buildsystem": "simple",
      "build-commands": [
        "make PREFIX=/app install"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/FFmpeg/nv-codec-headers.git",
          "commit": "e844e5b26f46bb77479f063029595293aa8f812d",
          "disable-submodules": true,
          "tag": "n13.0.19.0"
        }
      ]
    },
    {
      "name": "amf-headers",
      "buildsystem": "simple",
      "build-commands": [
        "install -d /app/include/AMF",
        "cp -a amf/public/include/* /app/include/AMF/"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/GPUOpen-LibrariesAndSDKs/AMF.git",
          "commit": "16f7d73e0b45c473e903e46981ed0b91efc4c091",
          "disable-submodules": true
        }
      ]
    },
    {
      "name": "onevpl",
      "post-install": [
        "install -Dm644 \"$FLATPAK_BUILDER_BUILDDIR/LICENSE\" /app/share/licenses/onevpl/LICENSE"
      ],
      "only-arches": [
        "x86_64"
      ],
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_TESTS=OFF",
        "-DBUILD_TOOLS=OFF",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/intel/libvpl.git",
          "tag": "v2.15.0",
          "commit": "c45b5d786bf7cdabbe49ff1bab78693ad78feb78",
          "disable-submodules": true
        }
      ]
    },
    {
      "name": "ffmpeg-lgpl",
      "buildsystem": "simple",
      "build-options": {
        "cflags": "-I/app/include",
        "env": {
          "MD_FFMPEG_CFLAGS": "-I/app/include",
          "MD_FFMPEG_JOBS": "2"
        }
      },
      "build-commands": [
        "chmod +x packaging/ffmpeg/*.sh",
        "sh build-ffmpeg.sh"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://ffmpeg.org/releases/ffmpeg-8.1.2.tar.xz",
          "sha256": "464beb5e7bf0c311e68b45ae2f04e9cc2af88851abb4082231742a74d97b524c",
          "dest": "ffmpeg-source",
          "archive-type": "tar-xz"
        },
        {
          "type": "file",
          "path": "build-ffmpeg.sh"
        },
        {
          "type": "file",
          "path": "../ffmpeg/build-minimal-lgpl.sh",
          "dest": "packaging/ffmpeg"
        },
        {
          "type": "file",
          "path": "../ffmpeg/profile-encoders.sh",
          "dest": "packaging/ffmpeg"
        },
        {
          "type": "file",
          "path": "../ffmpeg/verify-codecs.c",
          "dest": "packaging/ffmpeg"
        }
      ]
    },
    {
      "name": "nostrc",
      "post-install": [
        "install -Dm644 \"$FLATPAK_BUILDER_BUILDDIR/LICENSE\" /app/share/licenses/nostrc/LICENSE"
      ],
      "buildsystem": "simple",
      "build-commands": [
        "cmake -S . -B _build -G Ninja -C tests/packaging/nip-subset.cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/app/lib/metadesk-nostrc -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DBUILD_SHARED_LIBS=OFF -DNOSTR_WITH_GLIB=OFF -DENABLE_NIP5F=ON -DENABLE_NIP05=ON -DENABLE_NIP65=ON -DENABLE_NIP78=ON -DBUILD_TESTING=OFF -DCMAKE_PREFIX_PATH=/app",
        "cmake --build _build -j2",
        "cmake --install _build",
        "ar rcs /app/lib/metadesk-nostrc/lib/libnip65.a _build/nips/nip65/CMakeFiles/nip65.dir/src/nip65.c.o"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/chebizarro/nostrc.git",
          "commit": "6f7a8d025768d497bef700fe55eea1c687dac328",
          "disable-submodules": true
        }
      ]
    },
    {
      "name": "patchelf",
      "buildsystem": "autotools",
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/NixOS/patchelf/releases/download/0.18.0/patchelf-0.18.0.tar.bz2",
          "sha256": "1952b2a782ba576279c211ee942e341748fdb44997f704dd53def46cd055470b",
          "archive-type": "tar-bzip2"
        }
      ]
    }
  ]
}

{
  "name": "dependencies",
  "buildsystem": "simple",
  "build-commands": [],
  "modules": [
    {
      "name": "cjson",
      "buildsystem": "cmake-ninja",
      "sources": [
        {
          "type": "archive",
          "url": "https://codeload.github.com/DaveGamble/cJSON/tar.gz/refs/tags/v1.7.19",
          "sha256": "7fa616e3046edfa7a28a32d5f9eacfd23f92900fe1f8ccd988c1662f30454562",
          "archive-type": "tar-gzip"
        }
      ],
      "config-opts": [
        "-DENABLE_CJSON_TEST=OFF",
        "-DENABLE_CJSON_UTILS=OFF",
        "-DBUILD_SHARED_LIBS=ON",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
        "-DCMAKE_INSTALL_LIBDIR=lib"
      ]
    },
    {
      "name": "libb2",
      "buildsystem": "autotools",
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/BLAKE2/libb2/releases/download/v0.98.1/libb2-0.98.1.tar.gz",

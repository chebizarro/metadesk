<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Metadesk" Manufacturer="Chris Daley" Version="$(var.Version)"
           UpgradeCode="0D682EE1-44D8-49AA-865E-EB91C50890FB" Scope="perUser"
           Language="1033" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Metadesk is already installed."
                  Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="INSTALLDIR">
      <RegistrySearch Id="InstalledDirectory" Root="HKCU" Key="Software\Metadesk.Installer"
                      Name="InstallDir" Type="raw" />
    </Property>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLDIR" Name="Metadesk" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MetadeskMenu" Name="Metadesk">
        <Component Id="Menu" Guid="5DC0356F-C6A8-45D8-9A21-66FB203315CF">
          <Shortcut Id="HostShortcut" Name="Metadesk Host" Target="[INSTALLDIR]metadesk-host.exe"
                    WorkingDirectory="INSTALLDIR" />
          <Shortcut Id="ClientShortcut" Name="Metadesk Client" Target="[INSTALLDIR]metadesk-client.exe"
                    WorkingDirectory="INSTALLDIR" />
          <RemoveFolder Id="RemoveMenu" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\Metadesk.Installer" Name="Menu"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="UserPath" Guid="CA47491C-6A83-4CF0-9E17-EFCDFB6AEFB0">
        <Environment Id="CliPath" Name="PATH" Value="[INSTALLDIR]" Action="set"
                     Part="last" System="no" Permanent="no" />
        <RegistryKey Root="HKCU" Key="Software\Metadesk.Installer" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="Path" Type="integer" Value="1" KeyPath="yes" />
          <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLDIR]" />
        </RegistryKey>
        <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsParent" Directory="ProgramsFolder" On="uninstall" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="HostLogonControls" Guid="CB44D58F-FE41-40D2-BF1E-927B1EC0CE98">
        <File Id="HostTaskScript" Source="$(sys.SOURCEFILEDIR)host-task.ps1" />
        <RegistryValue Root="HKCU" Key="Software\Metadesk.Installer" Name="HostLogonControls"
                       Type="integer" Value="1" KeyPath="yes" />
        <Shortcut Id="EnableHostLogon" Directory="MetadeskMenu" Name="Enable Metadesk Host at logon"
                  Target="[SystemFolder]WindowsPowerShell\v1.0\powershell.exe"
                  Arguments="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]host-task.ps1&quot; -Action Install" />
      </Component>
    </DirectoryRef>
    <CustomAction Id="RemoveHostTask" Directory="SystemFolder" Execute="immediate" Return="check"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]host-task.ps1&quot; -Action Uninstall" />
    <InstallExecuteSequence>
      <Custom Action="RemoveHostTask" Before="RemoveFiles" Condition="$HostLogonControls = 2 AND ?HostLogonControls = 3" />
    </InstallExecuteSequence>
    <Feature Id="HostLogon" Title="Host logon task controls (opt-in)" Level="2"
             Description="Install the explicit Enable Host at logon action. Requires a provisioned host account. Uninstall stops and unregisters the task in the same user session.">
      <ComponentRef Id="HostLogonControls" />
    </Feature>
    <Feature Id="Main" Title="Metadesk" Level="1">
      <ComponentRef Id="UserPath" />
      <ComponentRef Id="Menu" />
      <ComponentGroupRef Id="Payload" />
    </Feature>
  </Package>
</Wix>

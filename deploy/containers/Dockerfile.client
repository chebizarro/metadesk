# validated on rootless Podman 4.9.3 / Ubuntu 24.04 aarch64; see reference/client-validation.md.
# Runtime only. Produce runtime-bundle outside this image with
#   reference/throwaway-bundle.sh SRC NOSTRC OUT -Dclient=true -Dsigner_nip5f=true -Dsigner_nip46=true
# (NIP-46 for --bunker at runtime; the Tier B host image uses the same bundle.)
# metadesk-host ships only for `metadesk-host account` (client role binding).
# Targets: decode (--no-display, no display stack) and gui (adds the pinned
# Wayland/EGL/GLES runtime that SDL2 dlopens; still needs an explicitly mounted socket).
# No desktop GL (libopengl0/libgl1): the client skips SDL's opengl renderer when
# neither libGL.so.1 nor libOpenGL.so.0 loads and uses GLES2 (md-rnc,
# client-validation.md).
ARG BASE=docker.io/library/ubuntu@sha256:73b999393d07f2bf65a40373778a44dc9a6d54ad7718d29247d8ff9413c4d6a8
FROM ${BASE} AS decode
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libgcc-s1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && userdel ubuntu && groupadd -g 1000 metadesk \
    && useradd -u 1000 -g 1000 -m -d /home/metadesk metadesk \
    && install -d -m 0700 -o 1000 -g 1000 /run/user/1000
COPY runtime-bundle/opt/metadesk/ /opt/metadesk/
RUN cd /opt/metadesk && sha256sum -c --quiet SHA256SUMS \
    && printf '/opt/metadesk/lib\n' > /etc/ld.so.conf.d/metadesk.conf && ldconfig \
    && ldd /opt/metadesk/bin/metadesk-client /opt/metadesk/bin/metadesk-host > /tmp/closure \
    && ! grep -q 'not found' /tmp/closure && rm /tmp/closure
ENV HOME=/home/metadesk XDG_RUNTIME_DIR=/run/user/1000 XDG_CONFIG_HOME=/home/metadesk/.config
USER 1000:1000
ENTRYPOINT ["/opt/metadesk/bin/metadesk-client"]
CMD ["--help"]

FROM decode AS gui
USER 0:0
RUN apt-get update && apt-get install -y --no-install-recommends \
      libwayland-client0=1.22.0-2.1build1 libwayland-cursor0=1.22.0-2.1build1 \
      libwayland-egl1=1.22.0-2.1build1 libxkbcommon0=1.6.0-1build1 \
      libegl1=1.7.0-1build1 libgles2=1.7.0-1build1 \
      libegl-mesa0=25.2.8-0ubuntu0.24.04.5 libgl1-mesa-dri=25.2.8-0ubuntu0.24.04.5 \
    && rm -rf /var/lib/apt/lists/*
USER 1000:1000

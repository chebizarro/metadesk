# ThreadSanitizer suppressions for test_nostr (md-0732).
#
# meson.build applies this file, with halt_on_error=1, to the two nostr tests
# when -Db_sanitize=thread and the nostrc build tree is itself compiled with
# -fsanitize=thread. A TSAN_OPTIONS value in the caller's environment still
# overrides those defaults (later options win).
#
# Why nostrc must be instrumented: nostrc synchronises with nsync (relay
# callback slots, libgo channels, wait groups, hash maps). With the stock
# uninstrumented nostrc archives and system libnsync, TSan sees none of those
# happens-before edges. It then reports ~2900 races per run, in nostr.c
# callbacks (relay state/AUTH/OK handlers vs md_nostr_create, publish_all vs
# its wait group, destroy vs relay threads) and in nostrc internals. None of
# them survives once nostrc and nsync are instrumented (0 in 20 runs). They are
# not suppressed here: they carry no nostrc frame, or only thread entry points,
# so suppressing them would hide metadesk's own code.
#
# Recipe (Linux; kernel ASLR needs setarch -R):
#   cmake -S <nostrc>/third_party/nsync -B nsync-tsan -DBUILD_SHARED_LIBS=ON \
#     -DNSYNC_ENABLE_TESTS=OFF -DCMAKE_BUILD_TYPE=RelWithDebInfo \
#     -DCMAKE_C_FLAGS='-fsanitize=thread -g' -DCMAKE_SHARED_LINKER_FLAGS=-fsanitize=thread
#   make -C nsync-tsan nsync
#   cmake -S <nostrc> -B nostrc-tsan -DCMAKE_BUILD_TYPE=RelWithDebInfo \
#     -DCMAKE_C_FLAGS='-fsanitize=thread -g' -DCMAKE_CXX_FLAGS='-fsanitize=thread -g' \
#     -DCMAKE_EXE_LINKER_FLAGS=-fsanitize=thread -DCMAKE_SHARED_LINKER_FLAGS=-fsanitize=thread \
#     <the -D options of the normal nostrc build>
#   make -C nostrc-tsan nostr nostrgo go_fiber nostr_nip51_core nostr_nip98 \
#     nostr_nip17_core nip11 nostr_json
#   meson setup build-tsan -Db_sanitize=thread -Db_lundef=false --buildtype=debug \
#     -Dnostrc_root=<nostrc> -Dnostrc_build_dir=<abs>/nostrc-tsan
#   LD_LIBRARY_PATH=<abs>/nsync-tsan setarch $(uname -m) -R meson test -C build-tsan
# Keep nostrc's channel options as in the normal build (no GO_ENABLE_TSAN), so
# the MPMC slot paths that ship are the ones checked.
#
# Entries match nostrc global variable names (TSan matches race: patterns
# against a racy global's name), never functions or modules: nostrc is linked
# statically into libmetadesk, so a module pattern would cover metadesk too.

# nostrc-xqwgo, fixed upstream in nostrc 7d8b55724 (atomic
# NOSTR_METRIC_HISTOGRAM handle cache): write_operations and
# nostr_relay_publish lazily initialise function-local static histogram
# handles without synchronisation, so concurrent relay writer and publisher
# threads race on them. Present in nostrc da2e4d62b and older. Remove these
# with md-d9tj once metadesk builds against nostrc >= 7d8b55724.
race:^h_ws_write_ns
race:^h_event_serialize_ns
